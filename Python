
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Painel Red</title>
<style>
* { box-sizing: border-box; }
body {
  margin: 0;
  padding: 20px;
  background: #080808;
  color: white;
  font-family: Arial, sans-serif;
  min-height: 100vh;
  overflow-x: hidden;
}
canvas {
  position: fixed;
  inset: 0;
  z-index: -1;
}
.card {
  width: 100%;
  max-width: 430px;
  margin: 30px auto;
  padding: 22px;
  border: 1px solid #e32929;
  border-radius: 16px;
  background: #151515ee;
  box-shadow: 0 0 22px #d7191933;
}
h1 {
  text-align: center;
  color: #ff3535;
}
input, button {
  width: 100%;
  padding: 13px;
  margin: 8px 0;
  border-radius: 9px;
  border: 1px solid #7d2525;
  background: #202020;
  color: white;
}
button {
  background: #c91e1e;
  border: 0;
  font-weight: bold;
  cursor: pointer;
}
button:hover { background: #f02d2d; }
.hidden { display: none; }
.tabs {
  display: flex;
  gap: 8px;
}
.tabs button { flex: 1; }
.option {
  padding: 13px;
  margin: 12px 0;
  border: 1px solid #383838;
  border-radius: 10px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.option input { width: auto; }
#demo {
  border: 1px solid #444;
  border-radius: 12px;
  background: #101010;
  padding: 12px;
  margin-top: 15px;
  text-align: center;
}
#target {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: #ff3434;
  margin: 20px auto;
  box-shadow: 0 0 15px red;
}
small { color: #aaa; }
</style>
</head>
<body>
<canvas id="galaxy"></canvas>

<section class="card" id="login">
  <h1>PAINEL RED</h1>
  <p style="text-align:center">Acesso ao painel de demonstração</p>
  <input id="password" type="password" placeholder="Digite a senha">
  <button onclick="entrar()">ENTRAR</button>
  <p id="erro" style="color:#ff5555;text-align:center"></p>
</section>

<section class="card hidden" id="painel">
  <h1>PAINEL RED</h1>
  <div class="tabs">
    <button onclick="aba('funcoes')">FUNÇÕES</button>
    <button onclick="aba('info')">INFORMAÇÕES</button>
  </div>

  <div id="funcoes">
    <div class="option">
      <span>Reduzir recuo (simulação)</span>
      <input type="checkbox" id="recuo">
    </div>
    <div class="option">
      <span>Reduzir atraso (simulação)</span>
      <input type="checkbox" id="atraso">
    </div>
    <div class="option">
      <span>Otimizar toque (simulação)</span>
      <input type="checkbox" id="toque">
    </div>

    <label for="sens">Sensibilidade: <b id="valor">50</b></label>
    <input id="sens" type="range" min="1" max="100" value="50"
      oninput="valor.textContent=this.value">

    <button onclick="iniciarDemo()">INICIAR DEMONSTRAÇÃO</button>
    <div id="demo">
      <p id="estado">Demonstração parada</p>
      <div id="target"></div>
      <small>Área de teste visual do próprio projeto</small>
    </div>
  </div>

  <div id="info" class="hidden">
    <h3>Sobre o painel</h3>
    <p>Este é um protótipo educativo. Os controles alteram apenas a demonstração desta página.</p>
    <p>Não modifica outros jogos ou aplicativos.</p>
  </div>
</section>

<script>
function entrar() {
  if (document.getElementById("password").value === "123") {
    document.getElementById("login").classList.add("hidden");
    document.getElementById("painel").classList.remove("hidden");
  } else {
    document.getElementById("erro").textContent = "Senha incorreta.";
  }
}

function aba(nome) {
  document.getElementById("funcoes").classList.toggle("hidden", nome !== "funcoes");
  document.getElementById("info").classList.toggle("hidden", nome !== "info");
}

let demoAtiva = false;
let pos = 0;

function iniciarDemo() {
  demoAtiva = !demoAtiva;
  document.getElementById("estado").textContent =
    demoAtiva ? "Demonstração ativa" : "Demonstração parada";
}

function animar() {
  const alvo = document.getElementById("target");
  if (demoAtiva) {
    const sens = Number(document.getElementById("sens").value);
    const recuo = document.getElementById("recuo").checked;
    const toque = document.getElementById("toque").checked;
    const velocidade = toque ? 0.5 : 1;
    pos += velocidade * (sens / 50);
    const deslocamento = Math.sin(pos) * (recuo ? 10 : 30);
    alvo.style.transform = `translateX(${deslocamento}px)`;
  }
  requestAnimationFrame(animar);
}
animar();

// Fundo de partículas
const canvas = document.getElementById("galaxy");
const ctx = canvas.getContext("2d");
let pontos = [];

function redimensionar() {
  canvas.width = innerWidth;
  canvas.height = innerHeight;
  pontos = Array.from({length: 65}, () => ({
    x: Math.random() * canvas.width,
    y: Math.random() * canvas.height,
    vx: (Math.random() - 0.5) * 0.5,
    vy: (Math.random() - 0.5) * 0.5
  }));
}
function fundo() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  pontos.forEach((p, i) => {
    p.x += p.vx;
    p.y += p.vy;
    if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
    if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
    ctx.fillStyle = "#ff5555";
    ctx.fillRect(p.x, p.y, 2, 2);
    pontos.slice(i + 1).forEach(q => {
      const d = Math.hypot(p.x - q.x, p.y - q.y);
      if (d < 100) {
        ctx.strokeStyle = `rgba(255,50,50,${1-d/100})`;
        ctx.beginPath();
        ctx.moveTo(p.x, p.y);
        ctx.lineTo(q.x, q.y);
        ctx.stroke();
      }
    });
  });
  requestAnimationFrame(fundo);
}
window.addEventListener("resize", redimensionar);
redimensionar();
fundo();
</script>
</body>
</html>
